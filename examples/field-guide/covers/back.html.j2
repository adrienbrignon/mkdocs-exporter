<style data-teleport="head">
  /* A page of its own, without the header and the footer */
  @page back-cover {
    margin: 0;
    background: #1a237e url("/assets/contours.svg") center / cover;

    @top-left {
      content: none;
    }

    @top-right {
      content: none;
    }

    @bottom-center {
      content: none;
    }
  }

  .back-cover {
    page: back-cover;
    padding-top: 11cm;
    color: #c5cae9;
    font-family: "Helvetica Neue", Arial, sans-serif;
    text-align: center;

    svg {
      width: 1.6cm;
      height: 1.6cm;
      color: #ffca28;
    }

    .name {
      margin-top: 0.5cm;
      color: #fff;
      font-size: 16pt;
      font-weight: 600;
      letter-spacing: 0.3em;
      text-transform: uppercase;
    }

    .description {
      max-width: 10cm;
      margin: 0.4cm auto 0;
      font-size: 11pt;
      line-height: 1.5;
    }
  }
</style>
<div class="back-cover">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
    <circle cx="12" cy="12" r="10.5"/>
    <path d="M12 3.5 14.2 12 12 20.5 9.8 12Z" fill="currentColor" fill-opacity="0.35"/>
    <path d="M3.5 12 12 9.8 20.5 12 12 14.2Z"/>
  </svg>
  <div class="name">{{ config.site_name }}</div>
  <div class="description">{{ config.site_description }}</div>
</div>
