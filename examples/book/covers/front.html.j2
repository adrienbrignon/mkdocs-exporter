<style data-mkdocs-exporter-teleport="head">
  @page :first {
    margin: 0;
    background: #111;
  }

  .book-cover {
    break-after: page;
    padding: 6cm 1.5cm 0;
    color: #fff;
    font-family: Palatino, "Palatino Linotype", P052, Georgia, serif;
    text-align: center;

    .title {
      font-size: 30pt;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .rule {
      width: 2.5cm;
      height: 2px;
      margin: 0.7cm auto;
      background: #002fa7;
    }

    .subtitle {
      font-size: 12pt;
      font-style: italic;
      line-height: 1.5;
    }

    .author {
      margin-top: 9cm;
      font-size: 10pt;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }
  }
</style>
<div class="book-cover">
  <div class="title">{{ config.site_name }}</div>
  <div class="rule"></div>
  <div class="subtitle">
    {{ config.site_description if page.is_homepage else page.title }}
  </div>
  <div class="author">{{ config.site_author }}</div>
</div>
