<style data-teleport="head">
  @page :first {
    margin: 0;
  }

  .manual {
    position: relative;
    height: 27.6cm;
    box-sizing: border-box;
    padding: 2cm;
    break-after: page;
    color: #1a1a1a;
    font-family: "Roboto Mono", monospace;
    font-size: 10pt;
    line-height: 1.6;

    .header,
    .footer {
      display: flex;
      justify-content: space-between;
      font-size: 8.5pt;
    }

    .header {
      padding-bottom: 0.2cm;
      border-bottom: 1px solid;
    }

    .footer {
      position: absolute;
      right: 2cm;
      bottom: 0;
      left: 2cm;
      padding-top: 0.2cm;
      border-top: 1px solid;
    }

    .name {
      margin: 4cm 0 1.2cm;
      font-size: 40pt;
      font-weight: 500;
      line-height: 1.1;
      letter-spacing: -0.02em;

      &::after {
        content: "";
        display: inline-block;
        width: 0.5em;
        height: 0.85em;
        margin-left: 0.1em;
        vertical-align: -0.1em;
        background: var(--md-primary-fg-color);
      }
    }

    .label {
      margin-top: 0.6cm;
      color: var(--md-primary-fg-color);
      font-weight: 700;
    }

    .text {
      padding-left: 4ch;
    }

    .number {
      color: #9e9e9e;
    }

    .ruler {
      display: flex;
      gap: 2px;
      align-items: flex-end;
      height: 0.6cm;
      margin-top: 0.4cm;

      span {
        flex: 1;
        height: 40%;
        background: #d6d6d6;
      }

      .current {
        height: 100%;
        background: var(--md-primary-fg-color);
      }
    }

    .position {
      margin-top: 0.15cm;
      font-size: 8.5pt;
      text-align: right;
    }
  }
</style>
{% set name = page.title | lower | replace(" ", "-") %}
{% set toc = page.toc | list %}
{% set sections = toc[0].children if toc and toc[0].level == 1 else toc %}
{% set pages = navigation.pages if navigation else [] %}
{% set description = page.content.split("<p>")[1].split("</p>")[0] | striptags if "<p>" in page.content else "" %}
{% set related = (page.parent.children | selectattr("is_page") | rejectattr("url", "equalto", page.url) | list) if page.parent else [] %}
<div class="manual">
  <div class="header">
    <span>MKDOCS-EXPORTER(7)</span>
    <span>{{ page.parent.title if page.parent else config.site_name }}</span>
    <span>MKDOCS-EXPORTER(7)</span>
  </div>
  {% if pages %}
  <div class="ruler">
    {% for other in pages %}<span{% if other.url == page.url %} class="current"{% endif %}></span>{% endfor %}
  </div>
  {% for other in pages %}{% if other.url == page.url %}
  <div class="position">{{ "%02d" | format(loop.index) }} / {{ "%02d" | format(pages | length) }}</div>
  {% endif %}{% endfor %}
  {% endif %}
  <div class="name">{{ name }}</div>
  <div class="label">NAME</div>
  <div class="text">{{ name }} - {{ page.title }}</div>
  {% if description %}
  <div class="label">DESCRIPTION</div>
  <div class="text">{{ description }}</div>
  {% endif %}
  {% if sections %}
  <div class="label">SECTIONS</div>
  <div class="text">
    {% for section in sections[:10] %}
    <div><span class="number">{{ "%02d" | format(loop.index) }}</span> {{ section.title }}</div>
    {% endfor %}
  </div>
  {% endif %}
  {% if related %}
  <div class="label">SEE ALSO</div>
  <div class="text">
    {% for other in related %}{{ other.title | lower | replace(" ", "-") }}{{ ", " if not loop.last }}{% endfor %}
  </div>
  {% endif %}
  <div class="footer">
    <span>{{ version }}</span>
    <span>{{ config.site_name }}</span>
    <span>{{ config.site_url | replace("https://", "") | trim("/") }}</span>
  </div>
</div>
