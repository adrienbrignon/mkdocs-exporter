<style data-teleport="head">
  /* A page of its own, without the header and the footer */
  @page colophon {
    @top-center {
      content: none;
    }

    @bottom-center {
      content: none;
    }
  }

  .colophon {
    page: colophon;
    padding-top: 20cm;
    color: #1a1a1a;
    font-family: "Roboto Mono", monospace;
    font-size: 9pt;
    line-height: 1.6;

    .label {
      color: var(--md-primary-fg-color);
      font-weight: 700;
    }

    .text {
      max-width: 14cm;
      padding-left: 4ch;
    }
  }
</style>
<div class="colophon">
  <div class="label">COLOPHON</div>
  <div class="text">
    This document is a page of {{ config.site_url }}, printed by
    MkDocs Exporter {{ version }} with Chromium.
  </div>
</div>
